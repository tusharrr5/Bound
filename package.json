{
  "name": "bound",
  "version": "2.0.0",
  "description": "Merchant backend for AI shopping agents on Razorpay Test Mode, with a deterministic signed-mandate layer under the AI (hackathon project)",
  "license": "Apache-2.0",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "demo": "tsx src/scripts/demo.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run --no-file-parallelism",
    "test:concurrency": "vitest run tests/concurrency/reservation_race.test.ts",
    "test:policy": "vitest run tests/policy/policy_engine.test.ts",
    "test:webhooks": "vitest run tests/webhooks/webhook_verification.test.ts",
    "demo:agent": "tsx src/scripts/run-buyer-agent.ts",
    "demo:e2e": "tsx src/scripts/run-demo-e2e.ts",
    "arena:measure": "tsx src/scripts/measure-arena.ts",
    "arena:reset": "tsx src/scripts/reset-arena.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "razorpay": "^2.9.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
